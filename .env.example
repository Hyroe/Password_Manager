@'
# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL
#
# Local-development example only.
# Production credentials must come from the deployment secret store.
DATABASE_URL="postgresql://pm_app:pm_local_dev@127.0.0.1:5433/pm_dev?schema=public"

# WebAuthn
#
# localhost + HTTP are valid only outside production.
WEBAUTHN_RP_NAME="Password Manager"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:5173"

# Reverse proxy
#
# Leave unset when the API receives requests directly.
# Set only when the deployment has a known trusted proxy topology.
# Supported values: 1-10.
# TRUST_PROXY_HOPS=1

# Production requirements
#
# NODE_ENV=production requires:
#
# - WEBAUTHN_ORIGIN using HTTPS
# - WEBAUTHN_RP_ID other than localhost
# - WEBAUTHN_RP_ID matching the origin host or one of its parent domains
# - a production-safe EmailSender injected by the production server
#
# consoleEmailSender and noopEmailSender are intentionally rejected in production.
#
# Example:
#
# NODE_ENV=production
# WEBAUTHN_RP_ID="example.com"
# WEBAUTHN_ORIGIN="https://vault.example.com"
'@ | Set-Content .env.example